# English catalog of the JobLab plan microservice.
msgid ""
msgstr ""
"Project-Id-Version: joblab-plan-service 2.0\n"
"Language: en\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "No fue posible generar la estructura. Intenta nuevamente más tarde."
msgstr "The structure could not be generated. Please try again later."

msgid "Página inválida."
msgstr "Invalid page."

msgid "No existe un plan organizacional con id %(plan_id)s."
msgstr "There is no organizational plan with id %(plan_id)s."

msgid "El departamento indicado no existe dentro del plan."
msgstr "The given department does not exist in the plan."

msgid "Ya existe una vacante con ese nombre en el departamento."
msgstr "A vacancy with that name already exists in the department."

msgid "La vacante entra en conflicto con un registro existente."
msgstr "The vacancy conflicts with an existing record."

msgid "La vacante indicada no existe dentro del plan."
msgstr "The given vacancy does not exist in the plan."

msgid "El servicio de generación no está disponible en este momento."
msgstr "The generation service is not available right now."

msgid "Recurso no encontrado."
msgstr "Resource not found."

msgid "Método no permitido para este recurso."
msgstr "Method not allowed for this resource."

msgid "El cuerpo de la solicitud es demasiado grande."
msgstr "The request body is too large."

msgid "La solicitud no pudo ser procesada."
msgstr "The request could not be processed."

msgid "El microservicio no pudo procesar la solicitud."
msgstr "The microservice could not process the request."

msgid "El cuerpo JSON está mal formado."
msgstr "The JSON body is malformed."

msgid "El cuerpo debe ser un objeto JSON."
msgstr "The body must be a JSON object."

msgid "La solicitud contiene datos inválidos."
msgstr "The request contains invalid data."

msgid "Resumen público de planes organizacionales y vacantes generadas en JobLab."
msgstr "Public summary of the organizational plans and vacancies generated in JobLab."

msgid "Plan organizacional generado por el microservicio estrangulador"
msgstr "Organizational plan generated by the strangler microservice"

msgid "El nombre de la vacante debe ser texto."
msgstr "The vacancy name must be text."

msgid "El salario debe ser numérico."
msgstr "The salary must be numeric."

msgid "La descripción de la vacante debe ser texto."
msgstr "The vacancy description must be text."

msgid "Los conocimientos requeridos deben ser una lista."
msgstr "The required knowledge must be a list."

msgid "Cada conocimiento requerido debe ser texto."
msgstr "Each required knowledge item must be text."

msgid "El rol de reporte debe ser texto."
msgstr "The reporting role must be text."

msgid "Faltan campos obligatorios: %(fields)s."
msgstr "Required fields are missing: %(fields)s."

msgid "El plan indicado no es válido."
msgstr "The given plan is not valid."

msgid "El departamento indicado no es válido."
msgstr "The given department is not valid."

msgid "El departamento no pertenece al plan indicado."
msgstr "The department does not belong to the given plan."

msgid "La cantidad de puestos debe ser un número entero."
msgstr "The number of positions must be an integer."

msgid "La cantidad de puestos debe estar entre %(minimum)s y %(maximum)s."
msgstr "The number of positions must be between %(minimum)s and %(maximum)s."

msgid "El nombre de la vacante debe tener entre %(minimum)s y %(maximum)s caracteres."
msgstr "The vacancy name must have between %(minimum)s and %(maximum)s characters."

msgid "El salario debe ser un número finito."
msgstr "The salary must be a finite number."

msgid "El salario mínimo no puede ser negativo."
msgstr "The minimum salary cannot be negative."

msgid "El salario mínimo no puede superar el máximo."
msgstr "The minimum salary cannot exceed the maximum."

msgid "La moneda debe ser una de: %(options)s."
msgstr "The currency must be one of: %(options)s."

msgid "La periodicidad debe ser una de: %(options)s."
msgstr "The salary period must be one of: %(options)s."

msgid "La descripción de la vacante debe tener entre %(minimum)s y %(maximum)s caracteres."
msgstr "The vacancy description must have between %(minimum)s and %(maximum)s characters."

msgid "Debe existir al menos un conocimiento requerido."
msgstr "At least one required knowledge item is needed."

msgid "No puede haber más de %(maximum)s conocimientos requeridos."
msgstr "There cannot be more than %(maximum)s required knowledge items."

msgid "Cada conocimiento debe tener entre %(minimum)s y %(maximum)s caracteres."
msgstr "Each knowledge item must have between %(minimum)s and %(maximum)s characters."

msgid "El rol de reporte no puede superar %(maximum)s caracteres."
msgstr "The reporting role cannot exceed %(maximum)s characters."

msgid "La descripción de la empresa debe ser texto."
msgstr "The company description must be text."

msgid "Describe la empresa con al menos %(minimum)s caracteres."
msgstr "Describe the company with at least %(minimum)s characters."

msgid "La descripción no puede superar %(maximum)s caracteres."
msgstr "The description cannot exceed %(maximum)s characters."

msgid "La descripción contiene instrucciones dirigidas al sistema. Incluye solamente información sobre la empresa."
msgstr "The description contains instructions aimed at the system. Include only information about the company."
