# Copy this file to .env (never commit .env). Docker Compose reads it automatically.

# --- Django (front end / BFF) ---
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=False
# Add the EC2 Elastic IP or domain, e.g. localhost,127.0.0.1,django,54.12.34.56
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,django
# Only needed when the site is served over HTTPS or a non-default port, e.g. https://joblab.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
GUNICORN_WORKERS=3

# --- Gateway ---
GATEWAY_PORT=80

# --- PostgreSQL (one database per service: joblab for Django, plan_service for plan-service) ---
POSTGRES_DB=joblab
POSTGRES_USER=joblab
POSTGRES_PASSWORD=change-this-password
PLAN_DB_NAME=plan_service

# --- AI provider used by plan-service: MOCK (no key, no cost) or GOOGLE (Gemini) ---
AI_PROVIDER=MOCK
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# --- integration-service: third-party exchange rates (order = fallback chain) ---
EXCHANGE_PROVIDERS=open_er_api,frankfurter,static

# --- integration-service: allied team's JSON endpoint ---
ALLY_SERVICE_NAME=Equipo aliado
ALLY_SERVICE_URL=
# Dotted path to the list inside the ally's JSON (empty = auto-detect results/items/data)
ALLY_ITEMS_PATH=
# Comma-separated candidate field names (first one present wins)
ALLY_FIELD_TITLE=name,title,nombre,titulo
ALLY_FIELD_SUBTITLE=category,company,empresa,categoria,type,tipo
ALLY_FIELD_DESCRIPTION=description,descripcion,summary,resumen,detail
ALLY_FIELD_URL=url,link,enlace
ALLY_API_KEY=

# --- report-service / Celery worker: optional e-mail notifications ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL_FROM=joblab@localhost
NOTIFY_EMAIL_TO=
